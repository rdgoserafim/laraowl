APP_NAME=LaraOwl
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.com
APP_HOSTNAME=your-production-domain.com

ALLOW_REGISTRATION=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laraowl
DB_USERNAME=laraowl
DB_PASSWORD=changeme

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Use .your-domain.com to share sessions across subdomains (e.g. ws.your-domain.com)
SESSION_DOMAIN=.your-production-domain.com

BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# IMPORTANT: Generate strong random values for production.
# REVERB_APP_ID should be a random integer.
# REVERB_APP_KEY and REVERB_APP_SECRET should be random strings (>= 20 chars).
REVERB_APP_ID=000000
REVERB_APP_KEY=change-me-to-a-random-string
REVERB_APP_SECRET=change-me-to-a-random-secret

# Internal backend connection (Laravel -> Reverb) do not change.
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME="http"

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# Configure a real mail driver for production (smtp, postmark, mailgun, etc.)
# For local testing you can use "log", but in production emails will not be sent.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@your-production-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

# Caddy proxies /app* to the reverb container on the main hostname,
# so no dedicated ws.* subdomain (and no extra DNS record) is required.
VITE_REVERB_HOST="${APP_HOSTNAME}"
VITE_REVERB_PORT="443"
VITE_REVERB_SCHEME="https"
