FROM composer:2 AS composer

FROM php:8.3-fpm-alpine AS app
COPY --from=composer /usr/bin/composer /usr/bin/composer

# Install required dependencies
RUN apk --no-cache add \
    su-exec \
    postgresql-dev \
    libpng-dev \
    zlib-dev \
    oniguruma-dev \
    libzip-dev \
    zip \
    unzip \
    autoconf \
    gcc \
    g++ \
    make \
    bash \
    postgresql-client \
    linux-headers \
    libtool \
    nodejs \
    npm \
    nano

# Add extra PHP dependencies
RUN docker-php-ext-install pdo pgsql pdo_pgsql gd bcmath zip exif pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && docker-php-ext-configure pcntl --enable-pcntl

WORKDIR /usr/share/caddy/html/

# Copy composer files first for better layer caching
COPY composer.json composer.lock* ./
RUN composer install \
  --no-interaction \
  --no-progress \
  --no-scripts \
  && composer clear-cache

# Copy package files for npm layer caching
COPY package.json pnpm-lock.yaml* ./
RUN npm install \
  && npm cache clean --force

# Prepare Laravel directories
RUN php artisan package:discover --ansi || true \
  && mkdir -p storage bootstrap/cache \
  && chown -R www-data:www-data storage \
  && chown -R www-data:www-data bootstrap/cache \
  && chmod -R 775 storage \
  && chmod -R 775 bootstrap/cache

COPY ./docker/php-fpm-entrypoint.dev /usr/local/bin/php-entrypoint
RUN chmod a+x /usr/local/bin/*

ENTRYPOINT ["/usr/local/bin/php-entrypoint"]
CMD ["php-fpm"]
